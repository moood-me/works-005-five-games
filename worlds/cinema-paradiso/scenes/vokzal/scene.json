    "prompts": [
      {
        "text": "a small country station at dawn, a steam engine breathing at rest, a few birds, no melody",
        "weight": 1.2
      },
      {
        "text": "a steam train pulling out slowly, the chuffs gathering pace, fading into the distance",
        "weight": 0.4
      },
      {
        "text": "a cool empty platform in the evening, wind, a far dog, a train ticking as it cools",
        "weight": 0
      },
      {
        "text": "a soft celesta motif of five slow notes, nostalgic, Sicilian, very sparse",
        "weight": 0
      },
      {
        "text": "gentle strings, bright sadness, slow, no percussion",
        "weight": 0
      },
      {
        "text": "warm analog tape hiss and a low drone, still and tender",
        "weight": 0
      },
      {
        "text": "a station bell ringing twice, a whistle, then quiet",
        "weight": 0
      },
      {
        "text": "cicadas waking in the early morning, dry fields",
        "weight": 0
      },
      {
        "text": "a cane tapping slowly on stone, footsteps going away",
        "weight": 0
      },
      {
        "text": "mandolin tremolo far away, nostalgic, very quiet",
        "weight": 0
      },
      {
        "text": "low cello drone, solemn and tender",
        "weight": 0
      },
      {
        "text": "morning mist over Sicilian fields, still air, a cock crowing far off",
        "weight": 0
      },
      {
        "text": "a diesel railcar idling at an empty station at dusk",
        "weight": 0
      },
      {
        "text": "soft piano, sparse single notes, remembering",
        "weight": 0
      },
      {
        "text": "the hush after a train has gone, wind through wires",
        "weight": 0
      }
    ],
    "bpm": 60,
    "density": 0.15,
    "brightness": 0.4
  }
