  "music": {
    "prompts": [
      {
        "text": "Light orchestral travel music in the rhythm of steam train wheels, brisk pizzicato strings and woodwinds, 1870s optimism, forward motion",
        "weight": 1.2
      },
      {
        "text": "Steady clockwork ostinato on muted piano and marimba, like rails clicking under a carriage, calm and precise",
        "weight": 1.0
      },
      {
        "text": "Warm solo cello melody over a gentle rocking string pulse, night journey, a lamp-lit carriage",
        "weight": 0.5
      },
      {
        "text": "Minimalist repeating piano patterns in the manner of modern indie game scores, landscape passing by a window",
        "weight": 0.4
      },
      {
        "text": "Indian dawn: bansuri flute over a soft tanpura drone, slow and luminous, river light",
        "weight": 0
      },
      {
        "text": "American prairie: open fifths on strings and a lonely harmonica, wide empty space, low winter sun",
        "weight": 0
      },
      {
        "text": "Snowfield: glassy celesta and high sustained strings, white silence, slow",
        "weight": 0
      },
      {
        "text": "London December fog: muted brass chorale and soft timpani, gaslight, approaching the city",
        "weight": 0
      },
      {
        "text": "French musette accordion and light strings, cheerful, a valet humming by the window",
        "weight": 0
      },
      {
        "text": "Driving full orchestra, urgent strings in triplets, a special train racing against time",
        "weight": 0
      },
      {
        "text": "Slow solo piano, rubato, a train standing still in the night, waiting",
        "weight": 0
      },
      {
        "text": "Harp and clarinet duet, tender, a woman watching the river at sunrise",
        "weight": 0
      },
      {
        "text": "Low thunder of drums and double basses, a great herd of buffalo crossing, earthy and immense",
        "weight": 0
      },
      {
        "text": "Victorian chamber ensemble, string quartet travelling waltz, elegant and unhurried",
        "weight": 0
      },
      {
        "text": "Ambient pads and soft noise like wind past the glass, modern atmospheric game soundtrack",
        "weight": 0
      },
      {
        "text": "Brisk snare brushes and plucked bass imitating wheels on rail joints, playful and light",
        "weight": 0
      },
      {
        "text": "Glockenspiel and pizzicato counting the telegraph poles flicking by, bright and quick",
        "weight": 0
      },
      {
        "text": "Sitar and tabla in a measured travelling rhythm, warm afternoon heat, palms passing",
        "weight": 0
      },
      {
        "text": "Solo violin, folk-like, over a slow steam rhythm, villages at night with lit windows",
        "weight": 0
      },
      {
        "text": "Tense ticking clock and sustained strings rising, the last miles before London, time running out",
        "weight": 0
      }
    ],
    "bpm": 96,
    "density": 0.4,
    "brightness": 0.45
  }
