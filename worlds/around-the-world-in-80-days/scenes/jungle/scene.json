    },
    "smoke": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "the pyre's smoke: 0 — none, 1 — thick (thins towards 0)"
    },
    "beat": {
      "type": "string",
      "means": "a beat of the film (the module beats): drums, procession, pyre, rise, walk; at its end the scene says beat:<name>"
    },
    "heads": {
      "range": [
        0,
        1
      ],
      "means": "the crowd at the pyre: 0 — face down, 1 — on their knees, looking"
    },
    "walk": {
      "range": [
        0,
        1
      ],
      "means": "the «rajah» with the widow in his arms: how far he carries her from the pyre to the trees (0 — on the pyre, 1 — at the trees); the value set — he walks there at his own pace"
    },
    "fireflies": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "fireflies over the trail and the stream (the scene sets it itself by day: at night 1)"
    },
    "kiouni_x": {
      "type": "number",
      "smooth": true,
      "means": "where Kiouni is along the trail (m, as across); set by the scene — from the beats, ride, charge; he walks there at his own pace"
    },
    "kiouni_d": {
      "type": "number",
      "smooth": true,
      "means": "at what distance he is (m); set by the scene together with kiouni_x"
    },
    "kiouni_facing": {
      "type": "number",
      "smooth": true,
      "means": "which way he faces (degrees, as facing): 90 — going right, 270 — left; set by the scene"
    },
    "kiouni_el": {
      "type": "number",
      "smooth": true,
      "means": "how far he has sunk (m, ≤ 0), by kneel; set by the scene"
    },
    "kiouni_tilt": {
      "type": "number",
      "smooth": true,
      "means": "his tilt (degrees: − head down, + back), by kneel and balk; set by the scene"
    },
    "kiouni_here": {
      "range": [
        0,
        1
      ],
      "means": "1 — Kiouni in the scene, 0 — not"
    },
    "kneel": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "0 — standing, 1 — kneeling (the howdah low, to get in and out)"
    },
    "ears": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "the ears: 0 — hanging and flapping, 1 — fanned out"
    },
    "trunk": {
      "values": [
        "rest",
        "up",
        "sugar",
        "lift"
      ],
      "means": "the trunk: hanging, raised, reaching back to the howdah (sugar), lifting (Passepartout)"
    },
    "trumpet": {
      "range": [
        0,
        1
      ],
      "means": "a rise to 1 — he trumpets once (trunk up, head up, ears fanned out); set back to 0 before the next"
    },
    "kiouni_blow": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "how he trumpets now; set by the scene by trumpet"
    },
    "balk": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "balking: 0 — no, 1 — stopped dead, leaning back, head and ears up"
    }
