  "prompts": [
   {
    "text": "Stormy orchestral seascape, surging low strings and timpani rolls, a small boat in a typhoon, heroic and steady",
    "weight": 1.2
   },
   {
    "text": "Driving cellos and horns in F minor, waves rising and falling, brass swells, nineteenth-century adventure",
    "weight": 0.8
   },
   {
    "text": "A calm ticking celesta under the storm, an Englishman who does not hurry",
    "weight": 0.4
   },
   {
    "text": "Wind and rain, low drones, a boat creaking, sparse percussion",
    "weight": 0
   },
   {
    "text": "The storm dying away, a lone horn call, the sea grey and wide, hope on the horizon",
    "weight": 0
   },
   {
    "text": "A signal gun and a steamer turning, brisk strings and a bright trumpet",
    "weight": 0
   },
   {
    "text": "Sea shanty fragments on concertina against the gale, a gruff pilot",
    "weight": 0
   },
   {
    "text": "Tender solo violin in the spray, a woman calm amid the storm",
    "weight": 0
   },
   {
    "text": "Victorian adventure overture, full orchestra, waves and wind",
    "weight": 0
   },
   {
    "text": "Minimal ambient storm pads, modern game score, grey-green Pacific",
    "weight": 0
   },
   {
    "text": "Pounding taiko and low brass, the wall of a wave",
    "weight": 0
   },
   {
    "text": "Harp glissandi and flutes like spray, the boat cutting through",
    "weight": 0
   },
   {
    "text": "Bassoon and pizzicato, dry humour under the gale",
    "weight": 0
   },
   {
    "text": "Slow hymn-like brass after the typhoon, relief",
    "weight": 0
   },
   {
    "text": "Oriental colour in a European orchestra, the China Sea",
    "weight": 0
   },
   {
    "text": "Tense tremolo strings, the crest coming at the bow",
    "weight": 0
   }
  ]
 }
