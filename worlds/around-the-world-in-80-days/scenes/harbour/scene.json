  "music": {
    "scale": "A_FLAT_MAJOR_F_MINOR",
    "prompts": [
      {
        "text": "Night harbour in the Far East: soft guzheng and erhu over slow strings, lanterns on still water, distant ship's horn",
        "weight": 1.1
      },
      {
        "text": "Minimal ambient pads, water lapping, fog over a harbour, modern indie game score, slow and wide",
        "weight": 0.9
      },
      {
        "text": "Light orchestral travel music with pentatonic woodwinds, a busy harbour in pale daylight haze",
        "weight": 0.5
      },
      {
        "text": "Celesta and harp arpeggios like reflections on water, a steamer's lights going out of the harbour",
        "weight": 0.4
      },
      {
        "text": "Warm red-gold evening: dizi flute over plucked yangqin, unhurried, a tavern terrace under lanterns",
        "weight": 0
      },
      {
        "text": "Woozy detuned strings and slow glass harmonica, opium haze, lights swimming and doubling",
        "weight": 0
      },
      {
        "text": "Stately low brass and strings, a mail steamer casting off at night, smoke over the water",
        "weight": 0
      },
      {
        "text": "Clarinet and pizzicato, a sly detective pouring another glass for a talkative valet",
        "weight": 0
      },
      {
        "text": "Solo shakuhachi over soft taiko far away, Yokohama at night, a pagoda on the hill",
        "weight": 0
      },
      {
        "text": "Taiko drums and shamisen, a travelling acrobat troupe's show by the water, lively and bright",
        "weight": 0
      },
      {
        "text": "Comic orchestral tumble, a human pyramid collapsing softly, then applause",
        "weight": 0
      },
      {
        "text": "Grey morning sea: low strings and wind, an empty pier, a man looking at his watch",
        "weight": 0
      },
      {
        "text": "Brisk sea shanty rhythm on strings and concertina, a pilot boat raising her sails",
        "weight": 0
      },
      {
        "text": "Tender cello and harp, a woman left on the quay, her hand raised as a sail goes out",
        "weight": 0
      },
      {
        "text": "Gongs and low bells over a drone, mist banks drifting across the harbour",
        "weight": 0
      },
      {
        "text": "Bright full orchestra with Chinese percussion, reunion on the quay, warm and funny",
        "weight": 0
      },
      {
        "text": "Slow marimba ostinato like a ship's engine, smoke trail on the horizon",
        "weight": 0
      },
      {
        "text": "Victorian travelling waltz for small orchestra, an Englishman abroad, precise and unhurried",
        "weight": 0
      }
    ],
    "bpm": 72,
    "density": 0.35,
    "brightness": 0.45
  },
  "relief": "// the pontoon on the right floats low by the quay, 1.3 m down (people stand on it: the Tankadere's, Batulcar's): the ramp down to it from the quay's edge, its own level beyond\nif (across < 30 || across > 46 || distance < 4.9 || distance > 18.2) return 0;\nif (distance >= 7) return -1.3;\nif (across > 30.8 && across < 33.2) return -1.3 * (distance - 4.9) / 2.1;\nreturn 0;"
}
