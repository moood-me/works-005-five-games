  "music": {
    "prompts": [
      {
        "text": "Indian forest at dawn: bansuri flute over a soft tanpura drone, birds far off, slow and luminous",
        "weight": 1.1
      },
      {
        "text": "Light orchestral adventure, strings and woodwinds in a walking rhythm, an elephant's steady stride through the jungle",
        "weight": 0.9
      },
      {
        "text": "Low frame drums and dhol far away at night, a procession coming closer through the trees, tense and hushed",
        "weight": 0.5
      },
      {
        "text": "Minimal ambient pads, humid air, distant water, modern indie game score",
        "weight": 0.4
      },
      {
        "text": "Sitar and tabla in a measured travelling tala, warm afternoon heat",
        "weight": 0
      },
      {
        "text": "Solo cello and harp, a fire burning at dawn by a river, grave and tender",
        "weight": 0
      },
      {
        "text": "Pizzicato strings and clarinet, playful, a valet bargaining for an elephant",
        "weight": 0
      },
      {
        "text": "Shehnai over drones and conch shells, a temple at night, solemn ritual",
        "weight": 0
      },
      {
        "text": "Driving strings and timpani, a sudden rush out of the thicket, torches scattering",
        "weight": 0
      },
      {
        "text": "Glassy celesta and soft marimba, fireflies and moonlight in a jungle clearing",
        "weight": 0
      },
      {
        "text": "Orchestral swell of relief at morning, a train whistle in the distance, the line resumes",
        "weight": 0
      },
      {
        "text": "Santoor arpeggios, gentle and bright, a stream crossing a forest trail",
        "weight": 0
      },
      {
        "text": "Low brass and bowed bass, smoke and dread, a pyre lit at first light",
        "weight": 0
      },
      {
        "text": "Victorian travelling waltz for small orchestra, unhurried, English gentlemen in the tropics",
        "weight": 0
      },
      {
        "text": "Hand percussion and kalimba, light and quick, an elephant's ears flapping",
        "weight": 0
      },
      {
        "text": "Choir humming without words, a dead raja rising from the smoke, uncanny and slow",
        "weight": 0
      },
      {
        "text": "Wind through bamboo, sparse plucked strings, waiting hidden in the undergrowth",
        "weight": 0
      },
      {
        "text": "Bright full orchestra, escape through the forest at a run, comic and heroic",
        "weight": 0
      }
    ],
    "bpm": 84,
    "density": 0.4,
    "brightness": 0.5
  }
