  "music": {
    "prompts": [
      {
        "text": "Solo felt piano, slow and intimate, a quiet room by the sea at evening, modern indie game score",
        "weight": 1.2
      },
      {
        "text": "Warm low cello drone with a soft music-box melody far away, lamplight and patience",
        "weight": 0.8
      },
      {
        "text": "Ambient pads like sea air through an open window, airy and calm, minimalist",
        "weight": 0.7
      },
      {
        "text": "Four rising notes on a celesta, gentle and hopeful, repeating like a promise",
        "weight": 0
      },
      {
        "text": "Sparse nylon guitar fingerpicking, close and quiet, a craftsman at his bench",
        "weight": 0
      },
      {
        "text": "Soft clarinet melody over low strings, tender, a father and a daughter",
        "weight": 0
      },
      {
        "text": "Glassy synth swells with long reverb tails, morning light on pale walls",
        "weight": 0
      },
      {
        "text": "Neo-classical string quartet, sustained and silvery, slow tempo, nostalgic",
        "weight": 0
      },
      {
        "text": "Woodblock and soft marimba textures like small tools on wood, rhythmic and calm",
        "weight": 0
      },
      {
        "text": "Accordion very softly in another room, faded memory of a fishing village",
        "weight": 0
      },
      {
        "text": "Harp arpeggios and flute, impressionistic sea seen through glass",
        "weight": 0
